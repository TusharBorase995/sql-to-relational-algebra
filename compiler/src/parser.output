Grammar

    0 $accept: query $end

    1 query: set_query opt_semicolon

    2 opt_semicolon: %empty
    3              | SEMICOLON

    4 set_query: set_query UNION opt_all set_query
    5          | set_query INTERSECT opt_all set_query
    6          | set_query EXCEPT opt_all set_query
    7          | set_query MINUS opt_all set_query
    8          | select_stmt
    9          | LPAREN set_query RPAREN

   10 opt_all: %empty
   11        | ALL
   12        | DISTINCT

   13 select_stmt: SELECT opt_distinct select_list FROM from_clause opt_where opt_group_by opt_having opt_order_by

   14 opt_distinct: %empty
   15             | DISTINCT

   16 select_list: select_item
   17            | select_list COMMA select_item

   18 select_item: STAR
   19            | IDENTIFIER DOT STAR
   20            | expr opt_alias

   21 opt_alias: %empty
   22          | AS IDENTIFIER
   23          | IDENTIFIER

   24 from_clause: table_ref_list

   25 table_ref_list: table_ref
   26               | table_ref_list COMMA table_ref

   27 table_ref: table_atom
   28          | table_ref join_type JOIN table_atom ON expr
   29          | table_ref JOIN table_atom ON expr

   30 join_type: INNER
   31          | LEFT
   32          | LEFT OUTER
   33          | RIGHT
   34          | RIGHT OUTER

   35 table_atom: IDENTIFIER opt_alias
   36           | LPAREN table_ref RPAREN

   37 opt_where: %empty
   38          | WHERE expr

   39 opt_group_by: %empty
   40             | GROUP BY expr_list

   41 opt_having: %empty
   42           | HAVING expr

   43 opt_order_by: %empty
   44             | ORDER BY order_list

   45 order_list: order_item
   46           | order_list COMMA order_item

   47 order_item: expr opt_asc_desc

   48 opt_asc_desc: %empty
   49             | ASC
   50             | DESC

   51 expr_list: expr
   52          | expr_list COMMA expr

   53 in_expr_list: expr
   54             | in_expr_list COMMA expr

   55 expr: expr OR expr
   56     | expr AND expr
   57     | NOT expr
   58     | expr LIKE expr
   59     | expr NOT LIKE expr
   60     | expr IN LPAREN in_expr_list RPAREN
   61     | expr NOT IN LPAREN in_expr_list RPAREN
   62     | expr BETWEEN bit_expr AND bit_expr
   63     | expr NOT BETWEEN bit_expr AND bit_expr
   64     | bit_expr

   65 bit_expr: bit_expr EQ bit_expr
   66         | bit_expr NEQ bit_expr
   67         | bit_expr LT bit_expr
   68         | bit_expr LTE bit_expr
   69         | bit_expr GT bit_expr
   70         | bit_expr GTE bit_expr
   71         | LPAREN expr RPAREN
   72         | column_ref
   73         | literal
   74         | aggregate_expr

   75 aggregate_expr: COUNT LPAREN STAR RPAREN
   76               | COUNT LPAREN DISTINCT expr RPAREN
   77               | COUNT LPAREN expr RPAREN
   78               | SUM LPAREN DISTINCT expr RPAREN
   79               | SUM LPAREN expr RPAREN
   80               | AVG LPAREN DISTINCT expr RPAREN
   81               | AVG LPAREN expr RPAREN
   82               | MIN LPAREN expr RPAREN
   83               | MAX LPAREN expr RPAREN

   84 column_ref: IDENTIFIER
   85           | IDENTIFIER DOT IDENTIFIER

   86 literal: INT_LITERAL
   87        | FLOAT_LITERAL
   88        | STRING_LITERAL
   89        | TRUE_KW
   90        | FALSE_KW
   91        | NULL_KW


